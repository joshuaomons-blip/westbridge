# ------------------------------------------------------------------
# Westbridge Global Express — environment variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local or paste real keys into this example file.
# ------------------------------------------------------------------

# Public URL of the website (no trailing slash). Used for links in emails,
# the sitemap and password-reset redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Supabase dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used ONLY to invite new administrator accounts.
# Never prefix with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random secret (32+ characters) used to hash visitor IP addresses for
# rate limiting, so raw IPs are never stored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=replace-with-a-long-random-string
